# PostgreSQL - App Database
POSTGRES_APP_DB=fraud_db
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=admin

# PostgreSQL - Keycloak Database
POSTGRES_KEYCLOAK_DB=keycloak_db
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=keycloak

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_URL=jdbc:postgresql://postgres-keycloak:5432/${POSTGRES_KEYCLOAK_DB}

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ML Pipeline
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src
ML_PIPELINE_POSTGRES_HOST=postgres-app
ML_PIPELINE_POSTGRES_PORT=5432
ML_PIPELINE_POSTGRES_DB=${POSTGRES_APP_DB}
ML_PIPELINE_POSTGRES_USER=${POSTGRES_APP_USER}
ML_PIPELINE_POSTGRES_PASSWORD=${POSTGRES_APP_PASSWORD}
ML_PIPELINE_MINIO_ENDPOINT=minio:9000
ML_PIPELINE_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
ML_PIPELINE_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# ML Hybrid Service
ML_HYBRID_SERVICE_PORT=8001
ML_HYBRID_MINIO_ENDPOINT=http://minio:9000
ML_HYBRID_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
ML_HYBRID_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
ML_HYBRID_MINIO_BUCKET=fraud-datalake